APP_NAME=newsForGermanyRU-backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated browser/Capacitor origins. Capacitor Android WebView uses https://localhost — include it for local APK tests.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost,https://localhost
DATABASE_URL=sqlite:///./news.db
RSS_FETCH_LIMIT=30
# When RSS has no image, pipeline may GET the article page and parse og:image (one HTTP per item).
OG_IMAGE_FETCH_ENABLED=false
OG_IMAGE_FETCH_TIMEOUT_SECONDS=12
OG_IMAGE_MAX_RESPONSE_BYTES=2000000
RSS_FEED_MAX_ATTEMPTS=3
RSS_FEED_RETRY_BASE_DELAY_SECONDS=0.5
# Outbound HTTPS (RSS, OpenAI, Telegram, og:image, Hugging Face downloads for sentence-transformers).
HTTP_CA_BUNDLE_PATH=
# Local debugging only: false = skip TLS verification for all outbound HTTPS (insecure).
HTTP_VERIFY_SSL=true
OPENAI_REQUEST_RETRIES=1
# Lazy mobile full article (GET /news/{id}/full-article); empty = same as OPENAI_MODEL
OPENAI_FULL_ARTICLE_MODEL=
FULL_ARTICLE_FETCH_ENABLED=true
FULL_ARTICLE_FETCH_TIMEOUT_SECONDS=20
FULL_ARTICLE_MAX_RESPONSE_BYTES=2000000
FULL_ARTICLE_MAX_EXTRACT_CHARS=12000
FULL_ARTICLE_MAX_STORED_CHARS=50000
# Multi-replica: enable on one instance/process only, or use cron/separate worker.
PIPELINE_SCHEDULER_ENABLED=false
# Hourly at :00 from START through END (inclusive), in TIMEZONE (e.g. 6–22 ≈ 06:00 … 22:00).
PIPELINE_SCHEDULE_START_HOUR=6
PIPELINE_SCHEDULE_END_HOUR=22
PIPELINE_SCHEDULE_TIMEZONE=Europe/Berlin
PIPELINE_TASK_SWALLOW_ERRORS=true

# Human-readable logs: prefix each line with [run_id=...] during a pipeline run.
LOG_PREFIX_RUN_ID_PLAIN=true
# Production: one JSON object per line (overrides plain prefix when true).
LOG_JSON=false

# Optional: Sentry DSN (empty = disabled).
SENTRY_DSN=
# Optional: expose GET /metrics for Prometheus (disable or protect in production).
PROMETHEUS_METRICS_ENABLED=false

# Read-only provenance API: GET /internal/provenance/by-raw/{id}, /by-processed/{id}
# Header: X-Internal-Api-Key. Store in secrets; empty = routes return 404 (feature off).
# Do not expose publicly without network controls.
PROVENANCE_API_KEY=

# Staff operators: POST /auth/login, refresh, Bearer on /moderation/* and POST /pipeline/run
# Reader accounts (optional app users): POST /reader/auth/register, /reader/auth/login; GET /reader/auth/me (Bearer)
# Generate a long random secret for production (minimum 32 chars; required when APP_ENV=production).
JWT_SECRET_KEY=development-only-change-in-production-min-32-chars!!
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

AUTO_PUBLISH_THRESHOLD=0.85

LLM_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Telegram: breaking (⚡) autopublish → immediate. Other autopublish with AI importance ≥ TELEGRAM_DIGEST_MIN_IMPORTANCE
# → up to TELEGRAM_DIGEST_MAX_PER_SLOT messages at TELEGRAM_DIGEST_HOURS (Europe/Berlin by default).
# Moderator approvals from the queue → still immediate (manual moderation unchanged).
# PUBLIC_APP_BASE_URL: origin of the React app (deep link /news/{id} on “Читать в приложении”).
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Legacy aliases (still work): TELEGRAM_HTTP_CA_BUNDLE_PATH, TELEGRAM_HTTP_VERIFY_SSL — same as HTTP_* above.
PUBLIC_APP_BASE_URL=
TELEGRAM_DIGEST_SCHEDULER_ENABLED=true
TELEGRAM_DIGEST_HOURS=7,15,20
TELEGRAM_DIGEST_TIMEZONE=Europe/Berlin
TELEGRAM_DIGEST_MIN_IMPORTANCE=6
TELEGRAM_DIGEST_MAX_PER_SLOT=3
TELEGRAM_DIGEST_CANDIDATE_SCAN_LIMIT=120
# Urgent auto-publish only: attempts and base delay (seconds) for exponential backoff between attempts.
TELEGRAM_URGENT_SEND_MAX_ATTEMPTS=3
TELEGRAM_URGENT_SEND_RETRY_BASE_SECONDS=30
# When true, urgent Telegram runs in a background thread (pipeline is not blocked by retries/sleep).
TELEGRAM_URGENT_BACKGROUND_ENABLED=false
# Retries for moderator-approved posts and digest slots (full delivery failure each attempt).
TELEGRAM_MODERATION_SEND_MAX_ATTEMPTS=3
TELEGRAM_MODERATION_SEND_RETRY_BASE_SECONDS=5
TELEGRAM_DIGEST_SEND_MAX_ATTEMPTS=3
TELEGRAM_DIGEST_SEND_RETRY_BASE_SECONDS=5
# Table-lock TTL for digest on SQLite; PostgreSQL uses advisory locks instead.
TELEGRAM_DIGEST_LOCK_TTL_SECONDS=600
