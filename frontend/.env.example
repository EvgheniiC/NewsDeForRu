# Backend base URL (no trailing slash). No spaces around "=".
VITE_API_BASE_URL=http://127.0.0.1:8000

# Public web app origin for share links (deep links /news/{id}). Production default: https://simplenewsapp.de
# VITE_PUBLIC_APP_BASE_URL=https://simplenewsapp.de

# Android emulator: 127.0.0.1 inside the emulator is the device itself, not your PC. Use:
# VITE_API_BASE_URL=http://10.0.2.2:8000
#
# Physical phone (same Wi‑Fi as PC): use your PC LAN IP from ipconfig / ifconfig, and run uvicorn with --host 0.0.0.0
# VITE_API_BASE_URL=http://192.168.1.10:8000
